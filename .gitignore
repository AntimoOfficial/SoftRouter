# Publish only these areas. Operational material stays local by default.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/PUBLISH_FILES.txt
!/softrouter/
!/.github/

# Nested local configuration and diagnostics are never release inputs.
**/.DS_Store
**/.env
**/.env.*
**/gateway.conf
**/*.local.conf
**/*.log
**/*.pcap
**/*.pcapng
**/*.key
**/*.pem
**/authorized_keys
**/known_hosts
**/__pycache__/
**/runtime/
**/logs/
**/recovery*/
**/dist/
